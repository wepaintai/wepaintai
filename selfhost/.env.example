# Copy to selfhost/.env and fill in. Used by docker-compose.yml.

# Random 64-char hex string. Generate with:
#   openssl rand -hex 32
INSTANCE_SECRET=

INSTANCE_NAME=wepaintai

# Optional image overrides. docker-compose.yml already pins validated digests of
# ghcr.io/convex/convex-backend and ghcr.io/convex/convex-dashboard (the old
# ghcr.io/get-convex/* paths return 403). Set these only to upgrade, and always
# by digest. Preview slots default to the exact image ID currently running in
# the production backend container.
# CONVEX_BACKEND_IMAGE=ghcr.io/convex/convex-backend@sha256:...
# CONVEX_DASHBOARD_IMAGE=ghcr.io/convex/convex-dashboard@sha256:...

# Public URLs served by the Cloudflare Tunnel. Until the tunnel exists,
# leave these unset to default to localhost.
CONVEX_CLOUD_ORIGIN=https://convex.YOUR_DOMAIN
CONVEX_SITE_ORIGIN=https://convex-site.YOUR_DOMAIN

# What the dashboard (loopback-only, port 6791; use `ssh -L`) connects to.
NEXT_PUBLIC_DEPLOYMENT_URL=http://127.0.0.1:3210
