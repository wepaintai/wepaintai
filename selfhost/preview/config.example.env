# Machine-local configuration for the full-stack PR preview pool.
# Install as ~/apps/wepaintai-previews/config.env with mode 600.

# The current mini can safely run three fresh Convex preview backends as long
# as previews never run snapshot exports. Increase only after measuring Docker
# memory and disk capacity.
PREVIEW_POOL_SIZE=3
PREVIEW_MEMORY_LIMIT=768m
PREVIEW_CPU_LIMIT=1.5

# Optional. When omitted, deploy-preview.sh uses the exact image ID currently
# running in the production selfhost-backend-1 container.
# PREVIEW_CONVEX_IMAGE=ghcr.io/get-convex/convex-backend@sha256:...

# Use a Google OAuth web client intended for previews. Register each fixed
# slot callback, up to PREVIEW_POOL_SIZE:
# https://preview-auth-1.wepaint.ai/api/auth/callback/google
# https://preview-auth-2.wepaint.ai/api/auth/callback/google
# https://preview-auth-3.wepaint.ai/api/auth/callback/google
PREVIEW_GOOGLE_CLIENT_ID=
PREVIEW_GOOGLE_CLIENT_SECRET=

# Optional metered integrations. Use preview-only, budget-limited credentials.
PREVIEW_REPLICATE_API_TOKEN=
PREVIEW_REPLICATE_MODEL_VERSION=
PREVIEW_REPLICATE_TIMEOUT_SECONDS=180
PREVIEW_GEMINI_API_KEY=

# Optional Polar sandbox configuration. Never put production Polar credentials
# in this file. Register each preview-site slot webhook separately if checkout
# testing is enabled.
PREVIEW_POLAR_API_KEY=
PREVIEW_POLAR_WEBHOOK_SECRET=
PREVIEW_POLAR_PRODUCT_ID_50=
PREVIEW_POLAR_PRODUCT_ID_125=
PREVIEW_POLAR_API_BASE_URL=https://sandbox-api.polar.sh
