{
  "name": "wepaintai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "core-js",
      "esbuild"
    ]
  },
  "scripts": {
    "dev:app": "vite dev --port 3000",
    "dev:convex:local": "convex dev --local",
    "dev:convex:cloud": "convex dev --prod",
    "dev": "run-p \"dev:app\" \"dev:convex:local\"",
    "dev:cloud": "run-p \"dev:app\" \"dev:convex:cloud\"",
    "dev:prod-db": "VITE_CONVEX_URL=https://cool-crow-733.convex.cloud pnpm dev:app",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "deploy:convex": "convex deploy --env-file selfhost/.env.convex",
    "backup:convex": "selfhost/bin/backup.sh",
    "typecheck": "run-s typecheck:app typecheck:convex",
    "typecheck:app": "tsc --noEmit",
    "typecheck:convex": "tsc -p convex --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.33.0",
    "@clerk/tanstack-start": "^0.11.5",
    "@polar-sh/sdk": "^0.48.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "clsx": "^2.1.1",
    "convex": "^1.42.1",
    "convex-helpers": "^0.1.120",
    "framer-motion": "^12.42.2",
    "konva": "^10.3.0",
    "lucide-react": "^1.23.0",
    "nitro": "3.0.260610-beta",
    "perfect-freehand": "^1.2.3",
    "postcss": "^8.5.16",
    "posthog-js": "^1.398.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-konva": "^19.2.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  }
}
